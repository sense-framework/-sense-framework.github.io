publicSite"><header class="public-site-header"><button class="public-site-brand" data-public-home="1"><img src="./icon.svg" alt=""><b>SENSE</b></button><nav><button data-public-page="about">About</button><button data-public-page="support">Support</button><button data-public-page="developers">Developers</button><button data-public-page="careersPublic">Careers</button></nav><button class="public-site-close" id="closePublicSite">×</button></header><main class="public-site-main" id="publicSiteMain"></main><footer class="public-footer-site">${['trust','security','statusPublic','accessibility','cookies','privacy','terms'].map(k=>`<button data-public-page="${k}">${k==='statusPublic'?'Status':k[0].toUpperCase()+k.slice(1)}</button>`).join('')}</footer></section><section class="company-modal hidden" id="companyModal"><div class="glass company-modal-card"><header class="company-modal-head"><h2 id="companyModalTitle"></h2><button id="closeCompanyModal">×</button></header><div id="companyModalBody"></div></div></section>`)}
function enhanceAuth(){const card=$('.auth-card');if(!card||$('#portalTabs'))return;const oldForm=$('#loginForm'),preview=$('#preview');if(oldForm)oldForm.remove();card.querySelector('h1')?.insertAdjacentHTML('afterend',`<div class="portal-tabs" id="portalTabs"><button class="active" data-auth-mode="signin">Sign in</button><button data-auth-mode="create">Create account</button><button data-auth-mode="join">Join company</button></div><div class="portal-auth-body" id="portalAuthBody"></div>`);if(preview)preview.textContent='Temporary administrator';renderAuth()}
function renderAuth(){const root=$('#portalAuthBody');if(!root)return;$$('[data-auth-mode]').forEach(b=>b.classList.toggle('active',b.dataset.authMode===authMode));if(authMode==='signin')root.innerHTML=`<form id="portalSignIn"><label>Email<input name="email" type="email" autocomplete="email" required></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><button class="primary">Sign in</button></form><div class="portal-auth-actions"><button class="portal-sso" id="portalSso">Continue with company SSO</button><button class="portal-link" id="forgotPassword">Forgot password?</button></div><p class="portal-auth-note">One account can belong to multiple companies. Your role determines which controls appear.</p>`;
if(authMode==='create')root.innerHTML=`<form id="portalCreate"><label>Full name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Password<input name="password" type="password" minlength="8" required></label><label>Company name <small>Optional</small><input name="company"></label><button class="primary">Create account</button></form><p class="portal-auth-note">Adding a company creates a workspace and makes this account its owner.</p>`;
if(authMode==='join')root.innerHTML=`<form id="portalJoin"><label>Full name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Password<input name="password" type="password" minlength="8" required></label><label>Invitation code<input name="code" class="invite-code" required></label><button class="primary">Join company</button></form><p class="portal-auth-note">Company administrators create invitation codes from the Workspaces page.</p>`;
bindAuthForms()}
function bindAuthForms(){const sign=$('#portalSignIn');if(sign)sign.onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));const account=state.accounts.find(a=>a.email.toLowerCase()===d.email.toLowerCase());if(!account){toast('No local account. Create an account or use temporary administrator.');return}state.activeAccountId=account.id;state.activeWorkspaceId=account.lastWorkspaceId||state.workspaces.find(w=>w.members?.some(m=>m.accountId===account.id))?.id||null;record('Signed in');save();$('#preview')?.click()};
const create=$('#portalCreate');if(create)create.onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));if(state.accounts.some(a=>a.email.toLowerCase()===d.email.toLowerCase())){toast('An account with that email already exists.');return}const account={id:id('acct'),name:d.name.trim(),email:d.email.trim(),createdAt:new Date().toISOString(),lastWorkspaceId:null};state.accounts.push(account);state.activeAccountId=account.id;if(d.company.trim()){const w={id:id('org'),name:d.company.trim(),code:inviteCode(),createdAt:new Date().toISOString(),members:[{accountId:account.id,role:'Owner'}]};state.workspaces.push(w);state.activeWorkspaceId=w.id;account.lastWorkspaceId=w.id}record('Account created');save();$('#preview')?.click()};
const join=$('#portalJoin');if(join)join.onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));const workspace=state.workspaces.find(w=>w.code.toUpperCase()===d.code.trim().toUpperCase());if(!workspace){toast('Invitation code not found on this device.');return}let account=state.accounts.find