 class="glass empty-state"><span>⌘</span><h2>No developer resources</h2></div>`}
function renderIntegrations(){const root=$('#integrationList');if(!root)return;root.innerHTML=state.integrations.length?state.integrations.map(x=>`<article class="glass company-card"><header><h2>${esc(x.name)}</h2><button data-company-delete="integrations:${x.id}">×</button></header><p>${esc(x.endpoint||'')}</p><span class="status-pill">${esc(x.status||'Inactive')}</span></article>`).join(''):`<div class="glass empty-state"><span>⬡</span><h2>No integrations</h2></div>`}
function renderWorkspaces(){const root=$('#workspaceList');if(!root)return;const account=currentAccount();const list=account?state.workspaces.filter(w=>w.members?.some(m=>m.accountId===account.id)):state.workspaces;root.innerHTML=list.length?list.map(w=>{const m=account?w.members.find(x=>x.accountId===account.id):{role:'Owner'};return `<article class="glass workspace-row"><div><b>${esc(w.name)}</b><small>${esc(m?.role||'Member')} · <span class="invite-code">${esc(w.code)}</span></small></div><button data-switch-workspace="${w.id}">${w.id===state.activeWorkspaceId?'Active':'Open'}</button></article>`}).join(''):`<div class="glass empty-state"><span>▦</span><h2>No companies</h2></div>`}
function renderQueue(){const root=$('#supportQueue');if(!root)return;root.innerHTML=state.tickets.length?state.tickets.map(t=>`<div class="queue-row"><div><b>${esc(t.subject)}</b><small>${esc(t.id)} · ${esc(t.email)}</small></div><select data-ticket-status="${t.id}">${['Open','Pending','Resolved','Closed'].map(s=>`<option ${s===t.status?'selected':''}>${s}</option>`).join('')}</select><input data-ticket-assignee="${t.id}" value="${esc(t.assignee||'')}" placeholder="Assignee"></div>`).join(''):`<div class="empty-state"><span>?</span><h2>No tickets</h2></div>`}
function renderContentEditor(){const nav=$('#contentNav'),body=$('#contentBody'),title=$('#contentTitle');if(!nav||!body||!title)return;nav.innerHTML=Object.entries(PAGE_DEFS).map(([key,p])=>`<button class="${key===contentPage?'active':''}" data-content-page="${key}">${p.label}</button>`).join('');title.textContent=PAGE_DEFS[contentPage]?.label||contentPage;body.value=state.content[contentPage]||''}
function renderPublicInternalPages(){for(const [key,p] of Object.entries(PAGE_DEFS)){const root=$(`#${key}Internal`);if(!root)continue;const content=state.content[key]||'';root.innerHTML=content?`<p>${esc(content).replace(/\n/g,'<br>')}</p>`:`<div class="empty-state"><span>${p.icon}</span><h2>No content</h2></div>`}}
function updatePortalChrome(){const w=currentWorkspace(),a=currentAccount();if($('#workspaceName'))$('#workspaceName').textContent=w?.name||'No organization';if($('#roleChip'))$('#roleChip').textContent=role();if($('.avatar'))$('.avatar').textContent=(a?.name||'A').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();$$('.admin-only').forEach(n=>n.classList.toggle('hidden',!canAdmin()))}
function openModal(title,html,after){$('#companyModalTitle').textContent=title;$('#companyModalBody').innerHTML=html;$('#companyModal').classList.remove('hidden');after?.()}
function closeModal(){$('#companyModal').classList.add('hidden');$('#companyModalBody').innerHTML=''}
function ticketForm(email=''){return `<form class="support-form" id="ticketForm"><label>Email<input name="email" type="email" value="${esc(email)}" required></label><label>Category<select name="category"><option>General</option><option>Account</option><option>Technical</option><option>Billing</option><option>Security</option><option>Feature request</option></select></label><label>Priority<select name="priority"><option>Normal</option><option>Low</option><option>High</option><option>Urgent</option></select></label><label>Subject<input name="subject" required></label><label>Description<textarea name="description" required></textarea></label><button class="primary">Submit ticket</button></form>`}
function createTicket(data){const t={id:`TKT-${Math.random().toString(36).slice(2,8).toUpperCase()}`,email:data.email.trim(),category:data.category,priority:data.priority,subject:data.subject.trim(),description:data.description.trim(),status:'Open',assignee:'',createdAt:new Date().toISOString(),updates:[]};state.tickets.unshift(t);record(`Support ticket ${t.id} created`);save();return t}
function openTicket(tid){const t=state.tickets.find(x=>x.id===tid);if(!t)return;openModal(t.subject,`${ticketCard(t)}<form class="support-form" id="ticketReply"><label>Update<textarea name="message" required></textarea></label><button class="primary">Add update</button></form>`,()=>{$('#ticketReply').onsubmit=e=>{e.preventDefault();const message=new FormData(e.target).get('message').trim();t.updates.push({id:id('up'),message,at:new Date().toISOString(),accountId:state.activeAccountId});if(t.status==='Open')t.status='Pending';record(`Support ticket ${t.id} updated`);save();closeModal();toast('Ticket updated')}})}
function renderPublicPage(key){if(!key||!$('#publicSite'))return;publicPag