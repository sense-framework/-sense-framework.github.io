).addEventListener('click',e=>{if(e.target===$('#companyModal'))closeModal()});
$('#workspaceSwitcher').onclick=()=>showInternal('workspaces');$('#newSupportTicket').onclick=()=>openModal('New support ticket',ticketForm(currentAccount()?.email||''),()=>{$('#ticketForm').onsubmit=e=>{e.preventDefault();const t=createTicket(Object.fromEntries(new FormData(e.target)));closeModal();toast(`Ticket ${t.id} created`)}});$('#newHelpArticle').onclick=()=>openModal('New help article',`<form class="company-form" id="helpForm"><label>Title<input name="title" required></label><label>Article<textarea name="body" required></textarea></label><button class="primary">Save</button></form>`,()=>{$('#helpForm').onsubmit=e=>{e.preventDefault();state.helpArticles.unshift({id:id('help'),...Object.fromEntries(new FormData(e.target)),createdAt:new Date().toISOString()});record('Help article created');save();closeModal()}});
$('#newApiKey').onclick=()=>createDeveloper('apiKeys','API key');$('#newWebhook').onclick=()=>createDeveloper('webhooks','Webhook');$('#newOauth').onclick=()=>createDeveloper('oauthApps','OAuth app');$('#newIntegration').onclick=()=>openModal('New integration',`<form class="company-form" id="integrationForm"><label>Name<input name="name" required></label><label>Endpoint<input name="endpoint" type="url"></label><label>Status<select name="status"><option>Inactive</option><option>Active</option></select></label><button class="primary">Save</button></form>`,()=>{$('#integrationForm').onsubmit=e=>{e.preventDefault();state.integrations.unshift({id:id('int'),...Object.fromEntries(new FormData(e.target)),createdAt:new Date().toISOString()});record('Integration created');save();closeModal()}});
$('#newWorkspace').onclick=()=>openModal('New company',`<form class="company-form" id="workspaceForm"><label>Company name<input name="name" required></label><button class="primary">Create</button></form>`,()=>{$('#workspaceForm').onsubmit=e=>{e.preventDefault();let a=currentAccount();if(!a){a={id:id('acct'),name:'',email:'',createdAt:new Date().toISOString(),lastWorkspaceId:null};state.accounts.push(a);state.activeAccountId=a.id}const w={id:id('org'),name:new FormData(e.target).get('name').trim(),code:inviteCode(),createdAt:new Date().toISOString(),members:[{accountId:a.id,role:'Owner'}]};state.workspaces.push(w);state.activeWorkspaceId=w.id;a.lastWorkspaceId=w.id;record('Company created');save();closeModal()}});$('#joinWorkspace').onclick=()=>openModal('Join company',`<form class="company-form" id="joinWorkspaceForm"><label>Invitation code<input name="code" class="invite-code" required></label><button class="primary">Join</button></form>`,()=>{$('#joinWorkspaceForm').onsubmit=e=>{e.preventDefault();const code=new FormData(e.target).get('code').trim().toUpperCase(),w=state.workspaces.find(x=>x.code.toUpperCase()===code),a=currentAccount();if(!w||!a){toast('Invitation not found or no signed-in account.');return}if(!w.members.some(m=>m.accountId===a.id))w.members.push({accountId:a.id,role:'Member'});state.activeWorkspaceId=w.id;a.lastWorkspaceId=w.id;record('Company joined');save();closeModal()}});
$('#contentForm').onsubmit=e=>{e.preventDefault();state.content[contentPage]=$('#contentBody').value.trim();record(`${PAGE_DEFS[contentPage]?.label||contentPage} content updated`);save();toast('Published locally')};$('#profileButton')?.addEventListener('click',()=>{});$('#portalTabs')?.addEventListener('click',()=>{});$('#supportQueue')?.addEventListener('change',e=>{const status=e.target.closest('[data-ticket-status]');if(status){const t=state.tickets.find(x=>x.id===status.dataset.ticketStatus);if(t){t.status=status.value;record(`Ticket ${t.id} status changed`);save()}}const assign=e.target.closest('[data-ticket-assignee]');if(assign){const t=state.tickets.find(x=>x.id===assign.dataset.ticketAssignee);if(t){t.assignee=assign.value;save()}}});
window.addEventListener('sense:open',()=>{renderInternal()});window.addEventListener('hashchange',()=>{const v=location.hash.replace(/^#\//,'');if($(`#view-${v}`)&&!$('#app').classList.contains('hidden')&&!document.querySelector(`[data-view="${v}"]`))showInternal(v)});document.addEventListener('keydown',e=>{if(e.key==='Escape'){$('#publicDrawer')?.classList.add('hidden');closeModal()}})}
function createDeveloper(collection,label){openModal(`New ${label.toLowerCase()}`,`<form class="company-form" id="developerForm"><label>Name<input name="name" required></label><button class="primary">Create</button></form>`,()=>{$('#developerForm').onsubmit=e=>{e.preventDefault();state[collection].unshift({id:id('dev'),collection,name:new FormData(e.target).get('name').trim(),createdAt:new Date().toISOString()});record(`${label} created`);save();closeModal()}})}
function boot(){injectLanding();enhanceAuth();injectInternal();bind();renderInternal();if(location.hash.startsWith('#/public/'))openPublic(location.hash.split('/').pop())}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{on