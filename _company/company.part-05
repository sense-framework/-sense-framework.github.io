e=key;const main=$('#publicSiteMain'),p=PAGE_DEFS[key]||{label:key,icon:'○'};if(key==='support'){main.innerHTML=`<div class="public-page-head"><div><h1>Support</h1></div></div><div class="public-page-grid"><article class="glass public-panel"><h2>Submit a request</h2>${ticketForm(currentAccount()?.email||'')}</article><aside class="glass public-panel"><h2>Track a ticket</h2><form class="support-form" id="trackTicket"><label>Ticket ID<input name="id" class="invite-code" required></label><label>Email<input name="email" type="email" required></label><button class="secondary">Check status</button></form><div id="trackResult"></div></aside></div>`;$('#ticketForm').onsubmit=e=>{e.preventDefault();const t=createTicket(Object.fromEntries(new FormData(e.target)));e.target.reset();toast(`Ticket ${t.id} created`);$('#trackResult').innerHTML=`<div class="glass public-status-result"><b>${esc(t.id)}</b><p>Status: ${esc(t.status)}</p></div>`};$('#trackTicket').onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));const t=state.tickets.find(x=>x.id.toUpperCase()===d.id.trim().toUpperCase()&&x.email.toLowerCase()===d.email.trim().toLowerCase());$('#trackResult').innerHTML=t?`<div class="glass public-status-result"><b>${esc(t.id)}</b><p>${esc(t.subject)}</p><span class="status-pill status-${t.status.toLowerCase()}">${esc(t.status)}</span></div>`:`<div class="public-status-result"><p>Ticket not found.</p></div>`};return}
if(key==='contactPublic'){main.innerHTML=`<div class="public-page-head"><h1>Contact</h1></div><div class="public-page-grid"><article class="glass public-panel"><form class="support-form" id="publicContact"><label>Name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Message<textarea name="message" required></textarea></label><button class="primary">Submit</button></form></article><aside class="glass public-panel public-empty"><span>✉</span></aside></div>`;$('#publicContact').onsubmit=e=>{e.preventDefault();state.contact.unshift({id:id('contact'),...Object.fromEntries(new FormData(e.target)),createdAt:new Date().toISOString()});save();e.target.reset();toast('Submitted')};return}
if(key==='statusPublic'){const services=readWorkspaceCollection('services');main.innerHTML=`<div class="public-page-head"><h1>Status</h1></div><div class="company-page-grid">${services.length?services.map(s=>`<article class="glass company-card"><header><h2>${esc(s.name)}</h2><span class="status-pill">${esc(s.status||'Unknown')}</span></header></article>`).join(''):`<div class="glass public-empty"><span>●</span><p>No services published.</p></div>`}</div>`;return}
const content=state.content[key]||'';main.innerHTML=`<div class="public-page-head"><div><h1>${esc(p.label)}</h1></div></div><article class="glass public-panel ${content?'':'public-empty'}">${content?`<p>${esc(content).replace(/\n/g,'<br>')}</p>`:`<span>${p.icon}</span><p>No content published.</p>`}</article>`}
function readWorkspaceCollection(key){try{const raw=JSON.parse(localStorage.getItem('sense.workspace.empty.v1')||'{}');return Array.isArray(raw[key])?raw[key]:[]}catch{return[]}}
function openPublic(key){$('#publicDrawer').classList.add('hidden');$('#landing').classList.add('hidden');$('#publicSite').classList.remove('hidden');renderPublicPage(key)}
function closePublic(){$('#publicSite').classList.add('hidden');if($('#app').classList.contains('hidden'))$('#landing').classList.remove('hidden');publicPage=null}
function bind(){document.addEventListener('click',e=>{const auth=e.target.closest('[data-auth-mode]');if(auth){authMode=auth.dataset.authMode;renderAuth();return}const page=e.target.closest('[data-public-page]');if(page){openPublic(page.dataset.publicPage);return}if(e.target.closest('[data-open-auth]')){closePublic();$('#publicDrawer').classList.add('hidden');$('#auth').classList.remove('hidden');return}const cv=e.target.closest('[data-company-view]');if(cv){showInternal(cv.dataset.companyView);return}const cp=e.target.closest('[data-content-page]');if(cp){contentPage=cp.dataset.contentPage;renderContentEditor();return}const del=e.target.closest('[data-company-delete]');if(del){const [key,rid]=del.dataset.companyDelete.split(':');state[key]=state[key].filter(x=>x.id!==rid);record(`${key} record removed`);save();return}const sw=e.target.closest('[data-switch-workspace]');if(sw){state.activeWorkspaceId=sw.dataset.switchWorkspace;const a=currentAccount();if(a)a.lastWorkspaceId=state.activeWorkspaceId;record('Workspace switched');save();return}const op=e.target.closest('[data-ticket-open]');if(op){openTicket(op.dataset.ticketOpen);return}});
$('#publicMenuButton').onclick=()=>$('#publicDrawer').classList.remove('hidden');$('#closePublicDrawer').onclick=$('#publicDrawerScrim').onclick=()=>$('#publicDrawer').classList.add('hidden');$('#closePublicSite').onclick=closePublic;$$('[data-public-home]').forEach(b=>b.onclick=closePublic);$('#closeCompanyModal').onclick=closeModal;$('#companyModal'