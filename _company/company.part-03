ead"><h1>Public content</h1></header><div class="content-editor"><nav class="glass" id="contentNav"></nav><main class="glass"><form id="contentForm"><h2 id="contentTitle"></h2><textarea id="contentBody"></textarea><button class="primary">Save</button></form></main></div></section>
${emptyPage('documentation','Documentation','▤')}${emptyPage('changelog','Changelog','↻')}${emptyPage('roadmap','Roadmap','◇')}${emptyPage('newsroom','Newsroom','▥')}${emptyPage('press','Press','▧')}${emptyPage('partners','Partners','∞')}${emptyPage('accessibility','Accessibility','◎')}${emptyPage('trust','Trust Center','◆')}${emptyPage('disclosure','Responsible Disclosure','!')}${emptyPage('cookies','Cookie Policy','◌')}${emptyPage('acceptable','Acceptable Use','§')}${emptyPage('sla','Service Level Agreement','⌇')}${emptyPage('dpa','Data Processing Addendum','≡')}${emptyPage('subprocessors','Subprocessors','⋮')}${emptyPage('brand','Brand','S')}${emptyPage('feedback','Feedback','◉')}`}
function moreMarkup(){return `<button class="glass more-card" data-company-view="support"><span>?</span><b>Support</b></button><button class="glass more-card" data-company-view="help"><span>⌁</span><b>Help Center</b></button><button class="glass more-card" data-company-view="developers"><span>⌘</span><b>Developers</b></button><button class="glass more-card" data-company-view="documentation"><span>▤</span><b>Documentation</b></button><button class="glass more-card" data-company-view="integrations"><span>⬡</span><b>Integrations</b></button><button class="glass more-card" data-company-view="changelog"><span>↻</span><b>Changelog</b></button><button class="glass more-card" data-company-view="roadmap"><span>◇</span><b>Roadmap</b></button><button class="glass more-card" data-company-view="workspaces"><span>▦</span><b>Workspaces</b></button>`}
function showInternal(view){const target=$(`#view-${view}`);if(!target)return;$$('.view').forEach(v=>v.classList.toggle('active',v===target));$$('.nav-target,[data-company-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===view||b.dataset.companyView===view));$('#viewTitle').textContent=PAGE_DEFS[view]?.label||view.split('-').map(x=>x[0].toUpperCase()+x.slice(1)).join(' ');$('#workspace').scrollTop=0;history.pushState(null,'',`#/${view}`)}
function renderInternal(){if(!$('#view-support'))return;const account=currentAccount(),email=account?.email||'';const visible=canAdmin()?state.tickets:state.tickets.filter(t=>t.email.toLowerCase()===email.toLowerCase());const ticketList=$('#userTicketList');if(ticketList)ticketList.innerHTML=visible.length?visible.map(ticketCard).join(''):`<div class="glass empty-state"><span>?</span><h2>No tickets</h2></div>`;const open=visible.filter(t=>['Open','Pending'].includes(t.status)).length,resolved=visible.filter(t=>['Resolved','Closed'].includes(t.status)).length;if($('#supportOpenCount'))$('#supportOpenCount').textContent=open;if($('#supportResolvedCount'))$('#supportResolvedCount').textContent=resolved;if($('#adminTicketCount'))$('#adminTicketCount').textContent=state.tickets.length;renderHelp();renderDevelopers();renderIntegrations();renderWorkspaces();renderQueue();renderContentEditor();renderPublicInternalPages();updatePortalChrome()}
function ticketCard(t){return `<article class="glass ticket-card"><header><div><h2>${esc(t.subject)}</h2><small>${esc(t.id)} · ${fmt(t.createdAt)}</small></div><span class="status-pill status-${t.status.toLowerCase()}">${esc(t.status)}</span></header><p>${esc(t.description)}</p><div class="ticket-meta"><span>${esc(t.category)}</span><span>${esc(t.priority)}</span>${t.assignee?`<span>${esc(t.assignee)}</span>`:''}</div><div class="ticket-thread">${(t.updates||[]).map(u=>`<div class="ticket-update">${esc(u.message)}<small>${fmt(u.at)}</small></div>`).join('')}</div><button data-ticket-open="${t.id}">Open</button></article>`}
function renderHelp(){const root=$('#helpArticleList');if(!root)return;root.innerHTML=state.helpArticles.length?state.helpArticles.map(a=>`<article class="glass company-card"><header><h2>${esc(a.title)}</h2>${canAdmin()?`<button data-company-delete="helpArticles:${a.id}">×</button>`:''}</header><p>${esc(a.body)}</p></article>`).join(''):`<div class="glass empty-state"><span>⌁</span><h2>No articles</h2></div>`}
function renderDevelopers(){if($('#apiKeyCount'))$('#apiKeyCount').textContent=state.apiKeys.length;if($('#webhookCount'))$('#webhookCount').textContent=state.webhooks.length;if($('#oauthCount'))$('#oauthCount').textContent=state.oauthApps.length;const root=$('#developerRecords');if(!root)return;const rows=[...state.apiKeys.map(x=>({...x,type:'API key'})),...state.webhooks.map(x=>({...x,type:'Webhook'})),...state.oauthApps.map(x=>({...x,type:'OAuth app'}))];root.innerHTML=rows.length?rows.map(x=>`<article class="glass company-card"><header><h2>${esc(x.name)}</h2><button data-company-delete="${x.collection}:${x.id}">×</button></header><p>${esc(x.type)}</p><small>${fmt(x.createdAt)}</small></article>`).join(''):`<div