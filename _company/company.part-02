(a=>a.email.toLowerCase()===d.email.toLowerCase());if(!account){account={id:id('acct'),name:d.name.trim(),email:d.email.trim(),createdAt:new Date().toISOString(),lastWorkspaceId:workspace.id};state.accounts.push(account)}if(!workspace.members.some(m=>m.accountId===account.id))workspace.members.push({accountId:account.id,role:'Member'});state.activeAccountId=account.id;state.activeWorkspaceId=workspace.id;account.lastWorkspaceId=workspace.id;record('Company joined');save();$('#preview')?.click()};
$('#portalSso')?.addEventListener('click',()=>openModal('Company SSO',`<form class="company-form" id="ssoForm"><label>Company domain<input name="domain" placeholder="company.com" required></label><button class="primary">Continue</button></form>`,()=>{$('#ssoForm').onsubmit=e=>{e.preventDefault();toast('SSO activates when the authentication backend is connected.')}}));$('#forgotPassword')?.addEventListener('click',()=>toast('Password recovery activates when email delivery is connected.'))}
function injectInternal(){const workspace=$('#workspace');if(!workspace||$('#view-support'))return;workspace.insertAdjacentHTML('beforeend',internalMarkup());const more=$('#view-more .more-grid');if(more)more.insertAdjacentHTML('beforeend',moreMarkup());const system=$('#view-system .settings-grid');if(system)system.insertAdjacentHTML('beforeend',`<article class="glass panel link-list"><h2>Company</h2><button data-company-view="workspaces">Workspaces</button><button data-company-view="support">Support</button><button data-company-view="help">Help Center</button><button data-company-view="developers">Developers</button></article><article class="glass panel link-list admin-only"><h2>Administration</h2><button data-company-view="support-admin">Support queue</button><button data-company-view="content">Public content</button></article>`);const admin=$('#view-admin .admin-grid');if(admin)admin.insertAdjacentHTML('afterbegin',`<article class="glass panel metric"><h2>Support tickets</h2><strong id="adminTicketCount">0</strong></article>`);const crumb=$('.crumb');if(crumb&&!$('#workspaceSwitcher'))crumb.insertAdjacentHTML('afterend',`<button class="workspace-switcher" id="workspaceSwitcher"><span><small>Workspace</small><b id="workspaceName">No organization</b></span><i>⌄</i></button><span class="role-chip" id="roleChip">Member</span>`)}
function internalMarkup(){const emptyPage=(idv,label,icon)=>`<section class="view" id="view-${idv}"><header class="page-head"><h1>${label}</h1></header><div class="glass document-panel" id="${idv}Internal"><div class="empty-state"><span>${icon}</span><h2>No content</h2></div></div></section>`;return `<section class="view" id="view-support"><header class="page-head"><h1>Support</h1><button class="primary" id="newSupportTicket">New ticket</button></header><div class="support-layout"><main class="support-ticket-list" id="userTicketList"></main><aside class="support-sidebar"><article class="glass support-metric"><small>OPEN</small><strong id="supportOpenCount">0</strong></article><article class="glass support-metric"><small>RESOLVED</small><strong id="supportResolvedCount">0</strong></article><button class="glass company-card" data-company-view="help"><span>?</span><b>Help Center</b></button></aside></div></section>
<section class="view" id="view-help"><header class="page-head"><h1>Help Center</h1><button class="primary admin-only" id="newHelpArticle">New article</button></header><div class="record-grid" id="helpArticleList"></div></section>
<section class="view" id="view-developers"><header class="page-head"><h1>Developers</h1></header><div class="developer-grid"><article class="glass developer-card"><small>API KEYS</small><strong id="apiKeyCount">0</strong><button class="primary" id="newApiKey">New key</button></article><article class="glass developer-card"><small>WEBHOOKS</small><strong id="webhookCount">0</strong><button class="primary" id="newWebhook">New webhook</button></article><article class="glass developer-card"><small>OAUTH APPS</small><strong id="oauthCount">0</strong><button class="primary" id="newOauth">New app</button></article></div><div class="company-page-grid" id="developerRecords"></div></section>
<section class="view" id="view-integrations"><header class="page-head"><h1>Integrations</h1><button class="primary admin-only" id="newIntegration">New integration</button></header><div class="company-page-grid" id="integrationList"></div></section>
<section class="view" id="view-workspaces"><header class="page-head"><h1>Workspaces</h1><div class="company-toolbar"><button class="primary" id="newWorkspace">New company</button><button class="secondary" id="joinWorkspace">Join company</button></div></header><div class="workspace-list" id="workspaceList"></div></section>
<section class="view" id="view-support-admin"><header class="page-head"><h1>Support queue</h1></header><div class="glass panel"><div id="supportQueue"></div></div></section>
<section class="view" id="view-content"><header class="page-h